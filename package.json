{
  "name": "tanstack-start-template",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "ultracite check --type-aware --type-check",
    "dev": "vite dev --port 3000",
    "fix": "ultracite fix --type-aware --type-check",
    "seo:verify": "node --experimental-strip-types scripts/verify-seo-output.mjs",
    "start": "node .output/server/index.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm seo:verify"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/router-plugin": "^1.168.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "srvx": "^1.0.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "^1.64.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "ultracite": "8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
